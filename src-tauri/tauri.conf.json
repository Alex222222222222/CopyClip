{
  "build": {
    "beforeDevCommand": "bash ./scripts/tailwindcss.sh && trunk serve",
    "beforeBuildCommand": "bash ./scripts/tailwindcss.sh && trunk build --release",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "productName": "CopyClip",
  "mainBinaryName": "CopyClip",
  "version": "0.3.9",
  "identifier": "org.eu.huazifan.copyclip",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "preferences",
        "title": "Copy Clip",
        "url": "preferences",
        "width": 1280,
        "height": 800,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}
